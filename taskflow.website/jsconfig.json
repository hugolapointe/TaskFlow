{
    "compilerOptions": {
      "baseUrl": ".",
     "paths": {
  "@/*": ["src/*"],
          "@common/*": ["src/common/*"],
            "@hooks/*": ["src/hooks/*"],
   "@utils/*": ["src/utils/*"],
  "@api/*": ["src/api/*"],
    "@context/*": ["src/context/*"],
       "@features/*": ["src/features/*"]
 },
"target": "ES2020",
"module": "ESNext",
        "jsx": "react-jsx",
 "moduleResolution": "bundler"
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist"]
}
